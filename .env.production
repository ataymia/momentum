# Firebase web app configuration for the `momentumdis` project.
#
# These identifiers are public by design: Firebase embeds them in every browser bundle. They grant no
# authority on their own — read/write access is enforced entirely by `firestore.rules` and by the
# `userAccess/{uid}` record an Administrator writes. Never add a service-account key or an admin secret here.
#
# Regenerate with:
#   firebase apps:sdkconfig WEB 1:491976021038:web:40525e54b9f28bd0983bbf --project momentumdis

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCP-WGSiZvZin_xgMBCnYgHqwxRYcqUl0Y
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=momentumdis.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=momentumdis
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=momentumdis.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=491976021038
NEXT_PUBLIC_FIREBASE_APP_ID=1:491976021038:web:40525e54b9f28bd0983bbf
NEXT_PUBLIC_FIREBASE_FUNCTIONS_BASE_URL=https://us-central1-momentumdis.cloudfunctions.net
