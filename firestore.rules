rules_version = '2';

// ---------------------------------------------------------------------------
// GENERATED FILE — DO NOT EDIT BY HAND.
// Source of truth: lib/firestore-domains.ts + lib/firebase-access.ts
// Regenerate with: npm run rules:build
//
// Momentum stores each engine's state as one JSON document per storage key. In production that document is
// sharded so these rules can gate it by role and by owner:
//
//   domains/{domainId}/fields/{field}        shared array field  -> { items: [...] }
//   domains/{domainId}/fields/_root          non-array remainder -> { data: {...} }
//   userDomains/{uid}/{domainId}/{field}     per-user shard or chunk manifest
//   userDomains/{uid}/{domainId}/{field}__chunk_000000  bounded chunk -> { items: [...] }
//
// Identity is held separately:
//
//   userAccess/{uid}          authority for role, reporting line, and account state (Administrator-written)
//   employeeDirectory/{uid}   workspace-facing profile every employee may read
//   usernames/{username}      private login-name -> identity map, denied to every client
//   usernameReminders/{uid}   forgot-username requests an Administrator resolves
//   platform/bootstrap        one-time marker for the first Administrator claim
//   platform/meta             monotonic per-document version stamps used for change polling
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // --- identity helpers ---------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function accessPath(uid) {
      return /databases/$(database)/documents/userAccess/$(uid);
    }

    function hasAccessRecord() {
      return signedIn() && exists(accessPath(request.auth.uid));
    }

    function access() {
      return get(accessPath(request.auth.uid)).data;
    }

    function role() {
      return access().role;
    }

    /** Any provisioned employee, including one still onboarding. Mirrors roleAllows(`hasAccess`). */
    function isEmployee() {
      return hasAccessRecord()
        && role() != 'Customer'
        && access().accountState != 'Suspended'
        && access().accountState != 'Separated';
    }
    function hasAccess() {
      return isEmployee();
    }

    /** Mirrors roleAllows(`activeEmployee`). */
    function activeEmployee() {
      return isEmployee() && access().accountState == 'Active';
    }

    function isActiveRole(wanted) {
      return activeEmployee() && role() == wanted;
    }

    function isAdmin() {
      return isActiveRole('Administrator');
    }

    /** Mirrors buildPersistenceScope(): a Sales Manager supervises direct reports and their managed teams. */
    function manages(uid) {
      return uid != request.auth.uid
        && isActiveRole('Sales Manager')
        && exists(accessPath(uid))
        && get(accessPath(uid)).data.role != 'Customer'
        && (
          get(accessPath(uid)).data.managerId == request.auth.uid
          || (
            access().managedTeams is list
            && get(accessPath(uid)).data.team in access().managedTeams
          )
        );
    }

    /** Narrow BA supervision. This never grants a Sales Representative general manager/HR access. */
    function supervisesBrandAmbassador(uid) {
      return uid != request.auth.uid
        && isActiveRole('Sales Representative')
        && exists(accessPath(uid))
        && get(accessPath(uid)).data.role == 'Brand Ambassador'
        && get(accessPath(uid)).data.managerId == request.auth.uid;
    }

    // --- first-Administrator bootstrap --------------------------------------
    //
    // The only path that does not require an existing Administrator. It requires a verified e-mail on the
    // allow-list below. Trim this list once real Administrators exist.

    function bootstrapEmails() {
      return ['vixarynholdings@gmail.com', 'momentumdistributioninc@gmail.com'];
    }

    function bootstrapClaimant() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in bootstrapEmails();
    }

    /** The claimant may only mint an active Administrator record for themselves. */
    function bootstrapSelfAccess(uid) {
      return bootstrapClaimant()
        && uid == request.auth.uid
        && request.resource.data.role == 'Administrator'
        && request.resource.data.accountState == 'Active'
        && request.resource.data.email.lower() == request.auth.token.email.lower();
    }

    // --- identity documents -------------------------------------------------

    match /userAccess/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || isAdmin() || manages(uid));
      allow list: if isAdmin();
      // An Administrator may never change their own role or account state; that requires a second Administrator.
      allow create: if bootstrapSelfAccess(uid)
        || (isAdmin() && uid != request.auth.uid);
      // The e-mail is written once, from the Firebase identity itself, and is never editable afterwards.
      // Production drifted exactly here: an access record was edited to an address the Auth identity did
      // not own, which silently pointed an Administrator grant at the wrong mailbox.
      //
      // The username is the login identifier and is owned by the Worker, which keeps it in step with
      // `usernames/{username}`. A browser that could edit it here would break that pairing.
      allow update: if isAdmin()
        && request.resource.data.email == resource.data.email
        && request.resource.data.get('username', '') == resource.data.get('username', '')
        && (
          uid != request.auth.uid
          || (
            request.resource.data.role == resource.data.role
            && request.resource.data.accountState == resource.data.accountState
          )
        );
      allow delete: if false;
    }

    // The private login-name -> identity map. Only the Worker's service account reads or writes it, and
    // service-account access bypasses these rules, so denying every client here costs nothing and means
    // a username can never be turned back into an e-mail address from a browser.
    match /usernames/{username} {
      allow read, write: if false;
    }

    // Forgot-username requests. Administrators read them to answer the employee; the Worker writes them.
    match /usernameReminders/{uid} {
      allow get, list: if isAdmin();
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    match /employeeDirectory/{uid} {
      allow get, list: if isEmployee();
      allow create, update: if isAdmin()
        || (bootstrapClaimant() && uid == request.auth.uid);
      allow delete: if false;
    }

    match /platform/bootstrap {
      allow get: if signedIn();
      allow write: if bootstrapClaimant();
    }

    match /platform/meta {
      // Every employee stamps a version here after a successful write so other sessions can poll for changes.
      allow get: if signedIn();
      allow write: if isEmployee() || bootstrapClaimant();
    }

    // Privileged offboarding log. Even an Administrator browser cannot write.
    match /employeeSeparations/{uid} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Immutable audit proof for owner-authorized off-route deliveries.
    // Only the authenticated server function may create these records.
    match /adminDeliveryOverrides/{orderId} {
      allow get, list: if activeEmployee();
      allow create, update, delete: if false;
    }

    // Future account editor MUST read true creator identity from Admin SDK.
    // Client-writable workspace.createdByUid is never proof of creation.
    // Neither an Administrator client nor a Sales Manager can mint provenance.
    match /accountCreatorProvenance/{accountId} {
      allow get, list, create, update, delete: if false;
    }

    // Personal CRM shorthand is never stored in shared customers/accounts.
    // Neither another employee nor an Administrator can read another UID's nickname.
    match /privateAccountNicknames/{uid}/accounts/{accountId} {
      allow get, list: if isEmployee() && request.auth.uid == uid;
      allow create, update: if isEmployee() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['accountId','nickname'])
        && request.resource.data.accountId == accountId
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 80;
      allow delete: if isEmployee() && request.auth.uid == uid;
    }

    // Delivery corrections are evaluated and committed atomically by trusted Functions.
    // Browsers can review requests but cannot forge approvals, invoice revisions or stock.
    match /deliveryCorrectionRequests/{requestId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /deliveryCorrectionActive/{orderId} {
      allow read, write: if false;
    }
    match /deliveryCorrectionAudit/{eventId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    // Automatically calculated overpayments are auditable liabilities, not
    // new payments or refunds. Browsers may not create or change amounts.
    match /customerCreditDue/{requestId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /deliveryInvoiceReissues/{requestId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    // The sandbox SKU master and unique-name index are server-owned.
    // Browser metadata writes are denied, even to Administrators.
    // Live QA products are visible in Administrator product/order screens, but
    // do not belong to real sellable stock or commerce. Only trusted Functions
    // may create SKUs, virtual receipts and status-transition events.
    match /archivedOrders/{orderId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /liveTestProducts/{skuId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /liveTestProductNames/{nameHash} {
      allow read, write: if false;
    }
    match /liveTestInventory/{skuId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /liveTestReceipts/{receiptId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /liveTestOrderReservations/{orderId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /liveTestOrderEvents/{eventId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /sandboxProducts/{skuId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /sandboxProductNames/{nameHash} {
      allow read, write: if false;
    }
    match /sandboxInventory/{skuId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /sandboxOrders/{orderId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /sandboxInvoices/{invoiceId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /sandboxStockReceipts/{receiptId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Backend-only immutable event history for account-profile edits.
    match /accountProfileEditEvents/{eventId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Server-only idempotency receipts prevent replayed account creation.
    match /accountCreationRequests/{requestId} {
      allow get, list, create, update, delete: if false;
    }

    // Review-only server notification candidates. Browsers cannot mint mail.
    match /notificationCandidates/{candidateId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    // Server-projected operational email failures. Administrators may read,
    // but no browser role can forge, edit, or delete them.
    match /notificationAdminEvents/{eventId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /emailOutbox/{messageId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /emailSuppressions/{recipientId} {
      allow read, write: if false;
    }

    match /salesVisitTargets/{uid}/weeks/{weekStart} {
      allow read: if isAdmin() || (activeEmployee()
        && (uid == request.auth.uid || manages(uid)));
      allow create, update: if (isAdmin() || manages(uid))
        && request.resource.data.keys().hasOnly(['userId','weekStart','target','updatedAt','updatedBy'])
        && request.resource.data.userId == uid
        && request.resource.data.weekStart == weekStart
        && request.resource.data.target is int && request.resource.data.target >= 0
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    // HR e-form receipt metadata never contains tax identifiers or document field values.
    // Only the trusted server can create/update it after verifying the signing provider.
    // Employees can query their own records using employeeUid == auth.uid; HR Administrators
    // can review across employees. Managers, Marketing and customers cannot see other people.
    match /hrSignedFormRecords/{recordId} {
      allow get, list: if isAdmin() || (isEmployee()
        && resource.data.employeeUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    // Server-owned, append-only audit events; no browser impersonation or deletion.
    match /hrSignedFormAudit/{auditId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    function marketingEditor() {
      return isActiveRole('Administrator') || isActiveRole('Marketing');
    }
    match /marketingAssetVersions/{versionId} {
      allow read: if marketingEditor() || (isEmployee()
        && resource.data.status == 'Approved' && resource.data.deleted == false);
      allow create: if marketingEditor()
        && request.resource.data.id == versionId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.assetId is string
        && request.resource.data.version is int && request.resource.data.version > 0
        && request.resource.data.status == 'Draft'
        && request.resource.data.deleted == false;
      allow update: if marketingEditor()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','updatedAt','updatedBy','deleted'])
        && request.resource.data.status in ['Draft','Approved','Archived']
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /marketingProductionRequests/{requestId} {
      allow read: if marketingEditor() || (activeEmployee()
        && resource.data.requesterId == request.auth.uid);
      allow create: if activeEmployee()
        && request.resource.data.id == requestId
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.history == [{'at': request.resource.data.createdAt, 'actorId': request.auth.uid, 'status': 'Requested'}]
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'Requested'
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.approvedVersionId == ''
        && request.resource.data.draftVersionId == ''
        && request.resource.data.ownerId == '';
      allow update: if marketingEditor()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ownerId','status','dueDate','draftVersionId','approvedVersionId','updatedAt','updatedBy','history'])
        && request.resource.data.history == resource.data.history.concat([{'at': request.resource.data.updatedAt, 'actorId': request.auth.uid, 'status': request.resource.data.status}])
        && request.resource.data.status in ['Requested','Assigned','Draft','Approval','Printing','Ready','Completed']
        && request.resource.data.updatedBy == request.auth.uid
        && (request.resource.data.approvedVersionId == '' ||
          (get(/databases/$(database)/documents/marketingAssetVersions/$(request.resource.data.approvedVersionId)).data.status == 'Approved'
          && get(/databases/$(database)/documents/marketingAssetVersions/$(request.resource.data.approvedVersionId)).data.deleted == false))
        && (!(request.resource.data.status in ['Printing','Ready','Completed']) || request.resource.data.approvedVersionId != '');
      allow delete: if false;
    }

    // --- engine state: shared shards ----------------------------------------

    match /domains {
    // momentum-demo-workspace-v5
    match /workspace/fields/{field} {
      allow get, list: if field in ['_root', 'accounts', 'activities', 'appointments', 'approvals', 'bulletins', 'customers', 'inventory', 'notifications', 'orders', 'placements', 'territories', 'timeEntries', 'timecards'] && (field in ['accounts', 'inventory', 'orders'] ? (activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse', 'Delivery Driver']) : field in ['timeEntries', 'timecards'] ? (hasAccess()) : (activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse']));
      allow write: if field in ['_root', 'accounts', 'activities', 'appointments', 'approvals', 'bulletins', 'customers', 'inventory', 'notifications', 'orders', 'placements', 'territories', 'timeEntries', 'timecards'] && (field in ['orders'] ? (activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse', 'Delivery Driver']) : field in ['timeEntries', 'timecards'] ? (activeEmployee()) : (activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse']));
    }

    // momentum-commercial-controls-v1
    match /commercial/fields/{field} {
      allow get, list: if field in ['_root', 'activities', 'appointments', 'approvals', 'inventoryLots', 'orders', 'territories'] && (field in ['inventoryLots', 'orders'] ? (activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse', 'Delivery Driver']) : (activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse']));
      allow write: if field in ['_root', 'activities', 'appointments', 'approvals', 'inventoryLots', 'orders', 'territories'] && (field in ['orders'] ? (activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse', 'Delivery Driver']) : (activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse']));
    }

    // momentum-crm-v1
    match /crm/fields/{field} {
      allow get, list: if field in ['_root', 'contacts', 'interactions', 'opportunities', 'responsibilityHistory'] && ((activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative']));
      allow write: if field in ['_root', 'contacts', 'interactions', 'opportunities', 'responsibilityHistory'] && ((activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative']));
    }

    // momentum-territory-v2
    match /territory/fields/{field} {
      allow get, list: if field in ['_root', 'assignments', 'exceptions', 'history', 'territories'] && ((activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse']));
      allow write: if field in ['_root', 'assignments', 'exceptions', 'history', 'territories'] && ((activeEmployee() && role() in ['Administrator', 'Sales Manager']));
    }

    // momentum-hcm-v4
    match /hcm/fields/{field} {
      allow get, list: if field in ['_root', 'acknowledgments', 'audit', 'availability', 'benefitEnrollments', 'benefitEvents', 'benefitPlans', 'candidates', 'compensation', 'compensationChanges', 'courses', 'dependents', 'documents', 'employees', 'employmentChanges', 'goals', 'interviews', 'leaveRequests', 'lifecycleCases', 'offers', 'policies', 'privateProfiles', 'profileChangeRequests', 'ptoAssignments', 'ptoLedger', 'ptoPolicies', 'requisitions', 'reviewCycles', 'reviews', 'shiftRequests', 'shifts', 'tasks', 'training', 'workflows'] && (field in ['candidates', 'interviews', 'lifecycleCases', 'offers', 'requisitions'] ? (activeEmployee() && role() in ['Administrator', 'Sales Manager']) : field in ['audit'] ? (isActiveRole('Administrator')) : (hasAccess()));
      allow write: if field in ['_root', 'acknowledgments', 'audit', 'availability', 'benefitEnrollments', 'benefitEvents', 'benefitPlans', 'candidates', 'compensation', 'compensationChanges', 'courses', 'dependents', 'documents', 'employees', 'employmentChanges', 'goals', 'interviews', 'leaveRequests', 'lifecycleCases', 'offers', 'policies', 'privateProfiles', 'profileChangeRequests', 'ptoAssignments', 'ptoLedger', 'ptoPolicies', 'requisitions', 'reviewCycles', 'reviews', 'shiftRequests', 'shifts', 'tasks', 'training', 'workflows'] && (field in ['audit', 'candidates', 'interviews', 'lifecycleCases', 'offers', 'requisitions'] ? (isActiveRole('Administrator')) : (activeEmployee() && role() in ['Administrator', 'Sales Manager']));
    }

    // momentum-identity-provisioning-v1
    match /identity/fields/{field} {
      allow get, list: if field in ['_root', 'drafts', 'records'] && ((isActiveRole('Administrator')));
      allow write: if field in ['_root', 'drafts', 'records'] && ((isActiveRole('Administrator')));
    }

    // momentum-brand-ambassador-v1
    match /brandAmbassador/fields/{field} {
      allow get, list: if field in ['_root', 'assignments'] && (field in ['assignments'] ? (isActiveRole('Administrator')) : (hasAccess()));
      allow write: if field in ['_root', 'assignments'] && ((isActiveRole('Administrator')));
    }

    // momentum-training-library-v1
    match /trainingLibrary/fields/{field} {
      allow get, list: if field in ['_root', 'audiences', 'materials'] && ((hasAccess()));
      allow write: if field in ['_root', 'audiences', 'materials'] && ((isActiveRole('Administrator')));
    }

    // momentum-document-templates-v1
    match /documentTemplates/fields/{field} {
      allow get, list: if field in ['_root', 'packets', 'templates'] && ((hasAccess()));
      allow write: if field in ['_root', 'packets', 'templates'] && ((isActiveRole('Administrator')));
    }

    // momentum-performance-v1
    match /performance/fields/{field} {
      allow get, list: if field in ['_root', 'goals', 'notes', 'reports', 'weeklyDrafts'] && ((activeEmployee()));
      allow write: if field in ['_root', 'goals', 'notes', 'reports', 'weeklyDrafts'] && ((activeEmployee() && role() in ['Administrator', 'Sales Manager']));
    }

    // momentum-commerce-v1
    match /commerce/fields/{field} {
      allow get, list: if field in ['_root', 'allocations', 'credits', 'invoices', 'notes', 'payments', 'refunds'] && ((activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Delivery Driver']));
      allow write: if field in ['_root', 'allocations', 'credits', 'invoices', 'notes', 'payments', 'refunds'] && ((isActiveRole('Administrator')));
    }

    // momentum-inventory-ledger-v1
    match /inventoryLedger/fields/{field} {
      allow get, list: if field in ['_root', 'counts', 'movements', 'nodes', 'reservations'] && (field in ['counts', 'movements', 'nodes', 'reservations'] ? (activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse', 'Delivery Driver']) : (activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse']));
      allow write: if field in ['_root', 'counts', 'movements', 'nodes', 'reservations'] && (field in ['movements', 'reservations'] ? (activeEmployee() && role() in ['Administrator', 'Operations', 'Warehouse', 'Delivery Driver']) : (activeEmployee() && role() in ['Administrator', 'Operations', 'Warehouse']));
    }

    // momentum-delivery-v1
    match /delivery/fields/{field} {
      allow get, list: if field in ['_root', 'overrides', 'tasks'] && ((activeEmployee() && role() in ['Administrator', 'Operations', 'Warehouse', 'Delivery Driver']));
      allow write: if field in ['_root', 'overrides', 'tasks'] && (field in ['overrides'] ? (isActiveRole('Administrator')) : (activeEmployee() && role() in ['Administrator', 'Operations', 'Delivery Driver']));
    }

    // momentum-finance-v3
    match /finance/fields/{field} {
      allow get, list: if field in ['_root', 'expenses'] && ((isActiveRole('Administrator')));
      allow write: if field in ['_root', 'expenses'] && ((isActiveRole('Administrator')));
    }

    // momentum-accounting-v1
    match /accounting/fields/{field} {
      allow get, list: if field in ['_root', 'accounts', 'journals', 'reconciliations', 'rules'] && ((isActiveRole('Administrator')));
      allow write: if field in ['_root', 'accounts', 'journals', 'reconciliations', 'rules'] && ((isActiveRole('Administrator')));
    }

    // momentum-marketing-v3
    match /marketing/fields/{field} {
      allow get, list: if field in ['_root', 'assets', 'attributions', 'campaigns', 'deliveryNotices', 'materialMovements', 'materials', 'partnerships', 'requests', 'spend', 'touches'] && (field in ['deliveryNotices'] ? (activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse', 'Delivery Driver']) : (activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse']));
      allow write: if field in ['_root', 'assets', 'attributions', 'campaigns', 'deliveryNotices', 'materialMovements', 'materials', 'partnerships', 'requests', 'spend', 'touches'] && ((activeEmployee() && role() in ['Administrator', 'Sales Manager']));
    }

    // momentum-payroll-v5
    match /payroll/fields/{field} {
      allow get, list: if field in ['_root', 'benefitTaxRules', 'disbursements', 'employees', 'employerTaxRules', 'liabilities', 'payGroups', 'runs', 'withholdingProfiles'] && ((isActiveRole('Administrator')));
      allow write: if field in ['_root', 'benefitTaxRules', 'disbursements', 'employees', 'employerTaxRules', 'liabilities', 'payGroups', 'runs', 'withholdingProfiles'] && ((isActiveRole('Administrator')));
    }

    // momentum-field-tracking-v1
    match /fieldTracking/fields/{field} {
      allow get, list: if field in ['_root', 'appointmentEvents', 'departureAlerts', 'exceptions', 'geofences', 'samples', 'sessions'] && ((activeEmployee() && role() in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse']));
      allow write: if field in ['_root', 'appointmentEvents', 'departureAlerts', 'exceptions', 'geofences', 'samples', 'sessions'] && ((activeEmployee() && role() in ['Administrator', 'Sales Manager']));
    }

    // momentum-audit-v1
    match /audit/fields/{field} {
      allow get, list: if field in ['_root', 'events'] && ((isActiveRole('Administrator')));
      allow write: if field in ['_root', 'events'] && ((isActiveRole('Administrator')));
    }

    // momentum-notification-rules-v1
    match /notificationRules/fields/{field} {
      allow get, list: if field in ['_root', 'deliveries', 'preferences'] && ((activeEmployee()));
      allow write: if field in ['_root', 'deliveries', 'preferences'] && (field in ['deliveries'] ? (activeEmployee()) : (isActiveRole('Administrator')));
    }

    // momentum-period-locks-v1
    match /periodLocks/fields/{field} {
      allow get, list: if field in ['_root', 'locks'] && ((activeEmployee()));
      allow write: if field in ['_root', 'locks'] && ((isActiveRole('Administrator')));
    }
    }

    // --- engine state: per-user shards --------------------------------------

    match /userDomains {

    // momentum-demo-workspace-v5
    match /{uid}/workspace/{field} {
      allow get, list: if field in ['timeEntries', 'timecards']
        && (uid == request.auth.uid ? isEmployee() : (isAdmin() || manages(uid) || false));
      allow write: if field in ['timeEntries', 'timecards']
        && (isAdmin() || (uid == request.auth.uid ? isEmployee() : ((manages(uid) && activeEmployee()) || false)));
    }

    // momentum-territory-v2
    match /{uid}/territory/{field} {
      allow get, list: if field in ['exceptions']
        && (uid == request.auth.uid ? isEmployee() : (isAdmin() || manages(uid) || false));
      allow write: if field in ['exceptions']
        && (isAdmin() || (uid == request.auth.uid ? isEmployee() : ((manages(uid) && activeEmployee()) || false)));
    }

    // momentum-hcm-v4
    match /{uid}/hcm/{field} {
      allow get, list: if field in ['acknowledgments', 'audit', 'availability', 'benefitEnrollments', 'benefitEvents', 'compensation', 'compensationChanges', 'dependents', 'documents', 'employmentChanges', 'goals', 'leaveRequests', 'privateProfiles', 'profileChangeRequests', 'ptoAssignments', 'ptoLedger', 'reviews', 'shiftRequests', 'tasks', 'training', 'workflows']
        && (uid == request.auth.uid ? isEmployee() : (isAdmin() || (!(field in ['audit', 'compensation']) && manages(uid)) || false));
      allow write: if field in ['acknowledgments', 'audit', 'availability', 'benefitEnrollments', 'benefitEvents', 'compensation', 'compensationChanges', 'dependents', 'documents', 'employmentChanges', 'goals', 'leaveRequests', 'privateProfiles', 'profileChangeRequests', 'ptoAssignments', 'ptoLedger', 'reviews', 'shiftRequests', 'tasks', 'training', 'workflows']
        && (isAdmin() || (uid == request.auth.uid ? (!(field in ['compensation', 'compensationChanges', 'employmentChanges', 'ptoAssignments', 'ptoLedger']) && isEmployee()) : ((!(field in ['audit', 'compensation']) && manages(uid) && activeEmployee()) || false)));
    }

    // momentum-identity-provisioning-v1
    match /{uid}/identity/{field} {
      allow get, list: if field in ['records']
        && (uid == request.auth.uid ? isEmployee() : (isAdmin() || (!(field in ['records']) && manages(uid)) || false));
      allow write: if field in ['records']
        && (isAdmin() || (uid == request.auth.uid ? isEmployee() : ((!(field in ['records']) && manages(uid) && activeEmployee()) || false)));
    }

    // momentum-brand-ambassador-v1
    match /{uid}/brandAmbassador/{field} {
      allow get, list: if field in ['assignments']
        && (uid == request.auth.uid ? isEmployee() : (isAdmin() || (!(field in ['assignments']) && manages(uid)) || (field in ['assignments'] && supervisesBrandAmbassador(uid))));
      allow write: if field in ['assignments']
        && (isAdmin() || (uid == request.auth.uid ? (!(field in ['assignments']) && isEmployee()) : ((!(field in ['assignments']) && manages(uid) && activeEmployee()) || (field in ['assignments'] && supervisesBrandAmbassador(uid) && activeEmployee()))));
    }

    // momentum-document-templates-v1
    match /{uid}/documentTemplates/{field} {
      allow get, list: if field in ['packets']
        && (uid == request.auth.uid ? isEmployee() : (isAdmin() || manages(uid) || false));
      allow write: if field in ['packets']
        && (isAdmin() || (uid == request.auth.uid ? isEmployee() : ((manages(uid) && activeEmployee()) || false)));
    }

    // momentum-performance-v1
    match /{uid}/performance/{field} {
      allow get, list: if field in ['goals', 'notes', 'reports', 'weeklyDrafts']
        && (uid == request.auth.uid ? isEmployee() : (isAdmin() || manages(uid) || false));
      allow write: if field in ['goals', 'notes', 'reports', 'weeklyDrafts']
        && (isAdmin() || (uid == request.auth.uid ? isEmployee() : ((manages(uid) && activeEmployee()) || false)));
    }

    // momentum-finance-v3
    match /{uid}/finance/{field} {
      allow get, list: if field in ['expenses']
        && (uid == request.auth.uid ? isEmployee() : (isAdmin() || manages(uid) || false));
      allow write: if field in ['expenses']
        && (isAdmin() || (uid == request.auth.uid ? isEmployee() : ((manages(uid) && activeEmployee()) || false)));
    }

    // momentum-marketing-v3
    match /{uid}/marketing/{field} {
      allow get, list: if field in ['requests']
        && (uid == request.auth.uid ? isEmployee() : (isAdmin() || manages(uid) || false));
      allow write: if field in ['requests']
        && (isAdmin() || (uid == request.auth.uid ? isEmployee() : ((manages(uid) && activeEmployee()) || false)));
    }

    // momentum-payroll-v5
    match /{uid}/payroll/{field} {
      allow get, list: if field in ['disbursements', 'employees', 'withholdingProfiles']
        && (uid == request.auth.uid ? isEmployee() : (isAdmin() || (!(field in ['disbursements', 'employees', 'withholdingProfiles']) && manages(uid)) || false));
      allow write: if field in ['disbursements', 'employees', 'withholdingProfiles']
        && (isAdmin() || (uid == request.auth.uid ? (!(field in ['disbursements', 'employees', 'withholdingProfiles']) && isEmployee()) : ((!(field in ['disbursements', 'employees', 'withholdingProfiles']) && manages(uid) && activeEmployee()) || false)));
    }

    // momentum-field-tracking-v1
    match /{uid}/fieldTracking/{field} {
      allow get, list: if field in ['appointmentEvents', 'departureAlerts', 'exceptions', 'samples', 'sessions']
        && (uid == request.auth.uid ? isEmployee() : (isAdmin() || (!(field in ['appointmentEvents', 'departureAlerts', 'exceptions', 'samples', 'sessions']) && manages(uid)) || false));
      allow write: if field in ['appointmentEvents', 'departureAlerts', 'exceptions', 'samples', 'sessions']
        && (isAdmin() || (uid == request.auth.uid ? isEmployee() : ((!(field in ['appointmentEvents', 'departureAlerts', 'exceptions', 'samples', 'sessions']) && manages(uid) && activeEmployee()) || false)));
    }

    // momentum-audit-v1
    match /{uid}/audit/{field} {
      allow get, list: if (field in ['events'] || field.matches('^events__chunk_[0-9]{6}$'))
        && (uid == request.auth.uid ? isEmployee() : (isAdmin() || (!((field in ['events'] || field.matches('^events__chunk_[0-9]{6}$'))) && manages(uid)) || false));
      allow write: if (field in ['events'] || field.matches('^events__chunk_[0-9]{6}$'))
        && (isAdmin() || (uid == request.auth.uid ? isEmployee() : ((!((field in ['events'] || field.matches('^events__chunk_[0-9]{6}$'))) && manages(uid) && activeEmployee()) || false)));
    }

    // momentum-notification-rules-v1
    match /{uid}/notificationRules/{field} {
      allow get, list: if field in ['deliveries', 'preferences']
        && (uid == request.auth.uid ? isEmployee() : (isAdmin() || (!(field in ['deliveries']) && manages(uid)) || false));
      allow write: if field in ['deliveries', 'preferences']
        && (isAdmin() || (uid == request.auth.uid ? isEmployee() : ((!(field in ['deliveries']) && manages(uid) && activeEmployee()) || false)));
    }
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
