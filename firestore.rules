rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Administrator bootstrap
    // ---------------------------------------------------------------------
    // Put the two all-powerful Administrator work e-mails here (lower-case),
    // e.g. return ['owner@momentumdistribution.com', 'you@momentumdistribution.com'];
    // Each listed, e-mail-verified account may claim Administrator for itself.
    // While the list is EMPTY, exactly one verified account may claim it once
    // (first come, first served) and must then provision everyone else.
    // =====================================================================
    function bootstrapEmails() { return []; }

    // ---------------------------------------------------------------------
    // Identity helpers. userAccess/{uid} is the only authority for role,
    // reporting line and account state. Only Administrators write it.
    // ---------------------------------------------------------------------
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && uid == request.auth.uid; }
    function accessPath(uid) { return /databases/$(database)/documents/userAccess/$(uid); }
    function hasAccess(uid) { return signedIn() && exists(accessPath(uid)); }
    function callerHasAccess() { return hasAccess(request.auth.uid); }
    function callerHasAccessAfter() { return signedIn() && existsAfter(accessPath(request.auth.uid)); }
    function myAccess() { return get(accessPath(request.auth.uid)).data; }
    function accessOf(uid) { return get(accessPath(uid)).data; }
    function employeeRole(role) { return role in ['Administrator', 'Sales Manager', 'Sales Representative', 'Operations', 'Warehouse']; }
    function isAdmin() { return callerHasAccess() && myAccess().role == 'Administrator' && myAccess().accountState == 'Active'; }
    function activeEmployee() { return callerHasAccess() && employeeRole(myAccess().role) && myAccess().accountState == 'Active'; }
    function roleIn(roles) { return activeEmployee() && myAccess().role in roles; }
    // Employees who may still write their own onboarding shards (not suspended/separated).
    function selfWritable() { return callerHasAccess() && employeeRole(myAccess().role) && myAccess().accountState in ['Password change required', 'Onboarding', 'Pending approval', 'Active']; }
    // Sales Managers manage direct reports and explicitly managed teams. Mirrors buildPersistenceScope().
    function manages(uid) {
      return activeEmployee() && myAccess().role == 'Sales Manager' && uid != request.auth.uid && hasAccess(uid)
        && employeeRole(accessOf(uid).role)
        && (accessOf(uid).managerId == request.auth.uid || accessOf(uid).team in myAccess().get('managedTeams', []));
    }

    function emailVerified() { return signedIn() && request.auth.token.email_verified == true; }
    function bootstrapPath() { return /databases/$(database)/documents/platform/bootstrap; }
    function bootstrapByList() { return bootstrapEmails().size() > 0 && emailVerified() && request.auth.token.email.lower() in bootstrapEmails(); }
    function bootstrapFirstClaim() { return bootstrapEmails().size() == 0 && emailVerified() && !exists(bootstrapPath()); }
    // The claim is one atomic batch: platform/bootstrap + userAccess + employeeDirectory + identity record.
    function bootstrapClaim() {
      return signedIn() && !callerHasAccess() && (bootstrapByList() || bootstrapFirstClaim())
        && getAfter(bootstrapPath()).data.claimedBy == request.auth.uid;
    }

    function validAccess(data) {
      return data.keys().hasAll(['email', 'role', 'team', 'accountState', 'updatedAt', 'updatedBy'])
        && data.email is string
        && (employeeRole(data.role) || data.role == 'Customer')
        && data.team in ['Leadership', 'Sales', 'Operations', 'Customer']
        && data.accountState in ['Password change required', 'Onboarding', 'Pending approval', 'Active', 'Suspended', 'Separated'];
    }

    match /platform/bootstrap {
      allow read: if signedIn();
      allow create: if request.resource.data.claimedBy == request.auth.uid && (bootstrapByList() || bootstrapFirstClaim());
      allow update: if request.resource.data.claimedBy == request.auth.uid && bootstrapByList();
      allow delete: if false;
    }

    // Change-detection document: writers bump a version key per document they touched.
    match /platform/meta {
      allow read: if callerHasAccess();
      allow create, update: if callerHasAccessAfter() && request.resource.data.keys().hasOnly(['versions']);
      allow delete: if false;
    }

    match /userAccess/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if validAccess(request.resource.data) && (
        (isAdmin() && uid != request.auth.uid)
        || (isSelf(uid) && bootstrapClaim() && request.resource.data.role == 'Administrator' && request.resource.data.accountState == 'Active')
      );
      allow update: if isAdmin() && uid != request.auth.uid && validAccess(request.resource.data);
      allow delete: if false;
    }

    match /employeeDirectory/{uid} {
      allow read: if isSelf(uid) || callerHasAccess();
      allow create: if isAdmin() || (isSelf(uid) && bootstrapClaim() && request.resource.data.role == 'Administrator');
      allow update: if isAdmin() || (isSelf(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'initials', 'accent', 'updatedAt']));
      allow delete: if false;
    }

    // =====================================================================
    // Engine state. Mirrors lib/firestore-domains.ts — keep both in sync.
    //   domains/{domainId}/fields/{field}      shared documents
    //   userDomains/{uid}/{domainId}/{field}   per-user shards
    // =====================================================================
    function validShard(field) {
      return (field == '_root' && request.resource.data.keys().hasOnly(['data']) && request.resource.data.data is map)
        || (field != '_root' && request.resource.data.keys().hasOnly(['items']) && request.resource.data.items is list);
    }

    function hcmRestrictedField(field) { return field in ['requisitions', 'candidates', 'interviews', 'offers', 'lifecycleCases']; }
    function hcmSharedRead(field) {
      return (field == 'audit' && isAdmin())
        || (hcmRestrictedField(field) && roleIn(['Administrator', 'Sales Manager']))
        || (field != 'audit' && !hcmRestrictedField(field) && callerHasAccess());
    }
    function hcmSharedWrite(field) {
      return ((field == 'audit' || hcmRestrictedField(field)) && isAdmin())
        || (field != 'audit' && !hcmRestrictedField(field) && roleIn(['Administrator', 'Sales Manager']));
    }

    function domainRead(domainId, field) {
      return (domainId == 'workspace' && activeEmployee())
        || (domainId == 'commercial' && activeEmployee())
        || (domainId == 'crm' && roleIn(['Administrator', 'Sales Manager', 'Sales Representative']))
        || (domainId == 'hcm' && hcmSharedRead(field))
        || (domainId == 'identity' && isAdmin())
        || (domainId == 'documentTemplates' && callerHasAccess())
        || (domainId == 'performance' && activeEmployee())
        || (domainId == 'commerce' && roleIn(['Administrator', 'Sales Manager', 'Sales Representative', 'Operations']))
        || (domainId == 'inventoryLedger' && activeEmployee())
        || (domainId == 'finance' && isAdmin())
        || (domainId == 'accounting' && isAdmin())
        || (domainId == 'marketing' && activeEmployee())
        || (domainId == 'payroll' && isAdmin())
        || (domainId == 'fieldTracking' && activeEmployee())
        || (domainId == 'audit' && isAdmin())
        || (domainId == 'notificationRules' && activeEmployee())
        || (domainId == 'periodLocks' && activeEmployee());
    }

    function domainWrite(domainId, field) {
      return (domainId == 'workspace' && activeEmployee())
        || (domainId == 'commercial' && activeEmployee())
        || (domainId == 'crm' && roleIn(['Administrator', 'Sales Manager', 'Sales Representative']))
        || (domainId == 'hcm' && hcmSharedWrite(field))
        || (domainId == 'identity' && isAdmin())
        || (domainId == 'documentTemplates' && isAdmin())
        || (domainId == 'performance' && roleIn(['Administrator', 'Sales Manager']))
        || (domainId == 'commerce' && isAdmin())
        || (domainId == 'inventoryLedger' && roleIn(['Administrator', 'Operations', 'Warehouse']))
        || (domainId == 'finance' && isAdmin())
        || (domainId == 'accounting' && isAdmin())
        || (domainId == 'marketing' && roleIn(['Administrator', 'Sales Manager']))
        || (domainId == 'payroll' && isAdmin())
        || (domainId == 'fieldTracking' && roleIn(['Administrator', 'Sales Manager']))
        || (domainId == 'audit' && isAdmin())
        || (domainId == 'notificationRules' && ((field == 'deliveries' && activeEmployee()) || (field != 'deliveries' && isAdmin())))
        || (domainId == 'periodLocks' && isAdmin());
    }

    match /domains/{domainId}/fields/{field} {
      allow read: if domainRead(domainId, field);
      allow create, update: if domainWrite(domainId, field) && validShard(field);
      allow delete: if isAdmin();
    }

    // Per-user shards: records whose owner field equals {uid}.
    function perUserField(domainId, field) {
      return (domainId == 'workspace' && field in ['timeEntries', 'timecards'])
        || (domainId == 'hcm' && field in ['privateProfiles', 'profileChangeRequests', 'acknowledgments', 'leaveRequests', 'availability', 'shiftRequests', 'dependents', 'benefitEnrollments', 'benefitEvents', 'training', 'goals', 'reviews', 'workflows', 'tasks', 'documents', 'employmentChanges', 'ptoAssignments', 'ptoLedger', 'compensation', 'compensationChanges', 'audit'])
        || (domainId == 'identity' && field == 'records')
        || (domainId == 'documentTemplates' && field == 'packets')
        || (domainId == 'performance' && field in ['goals', 'reports', 'notes'])
        || (domainId == 'finance' && field == 'expenses')
        || (domainId == 'marketing' && field == 'requests')
        || (domainId == 'payroll' && field in ['employees', 'withholdingProfiles', 'disbursements'])
        || (domainId == 'fieldTracking' && field in ['sessions', 'samples', 'appointmentEvents', 'exceptions', 'departureAlerts'])
        || (domainId == 'audit' && field == 'events')
        || (domainId == 'notificationRules' && field == 'preferences');
    }
    // Decisions the owner must never author about themselves (selfWrite:false in the domain spec).
    function ownerLockedField(domainId, field) {
      return (domainId == 'hcm' && field in ['employmentChanges', 'ptoAssignments', 'ptoLedger', 'compensation', 'compensationChanges'])
        || (domainId == 'payroll' && field in ['employees', 'withholdingProfiles', 'disbursements']);
    }
    // Shards a Sales Manager may not see or touch for their reports (managerRead/managerWrite:false).
    function managerBlockedField(domainId, field) {
      return domainId == 'identity' || domainId == 'payroll' || domainId == 'audit'
        || (domainId == 'hcm' && (field == 'compensation' || field == 'audit'));
    }
    function managerShard(uid, domainId, field) { return !managerBlockedField(domainId, field) && manages(uid); }

    // Employees may only move their own identity record forward through the onboarding states.
    function identitySelfTransition() {
      return request.resource.data.items.size() == 1 && resource.data.items.size() == 1
        && request.resource.data.items[0].userId == request.auth.uid
        && request.resource.data.items[0].source == resource.data.items[0].source
        && request.resource.data.items[0].provisionedBy == resource.data.items[0].provisionedBy
        && (
          request.resource.data.items[0].state == resource.data.items[0].state
          || (resource.data.items[0].state == 'Password change required' && request.resource.data.items[0].state == 'Onboarding')
          || (resource.data.items[0].state == 'Onboarding' && request.resource.data.items[0].state == 'Pending approval')
        );
    }

    match /userDomains/{uid}/{domainId}/{field} {
      allow read: if perUserField(domainId, field) && (isAdmin() || isSelf(uid) || managerShard(uid, domainId, field));
      allow create: if perUserField(domainId, field) && validShard(field) && (
        isAdmin()
        || (isSelf(uid) && domainId == 'identity' && bootstrapClaim())
        || (isSelf(uid) && domainId != 'identity' && selfWritable() && !ownerLockedField(domainId, field))
        || managerShard(uid, domainId, field)
      );
      allow update: if perUserField(domainId, field) && validShard(field) && (
        isAdmin()
        || (isSelf(uid) && selfWritable() && !ownerLockedField(domainId, field) && (domainId != 'identity' || identitySelfTransition()))
        || managerShard(uid, domainId, field)
      );
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
